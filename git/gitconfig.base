# vim: ft=gitconfig
[core]
  pager = delta

[include]
	path = ~/git/catppuccin/delta/catppuccin.gitconfig

[interactive]
  diffFilter = delta --color-only

[alias]
  # `git log` with patches shown with difftastic.
  dl = -c diff.external="difft --tab-width 2" log -p --ext-diff
  # Show the most recent commit with difftastic.
  ds = -c diff.external="difft --tab-width 2" show --ext-diff
  # `git diff` with difftastic.
  dft = -c diff.external="difft --tab-width 2" diff

[delta]
  navigate = true  # use n and N to move between diff sections
  tabs = 2
  # ANSI colors only so the terminal theme decides light/dark
  syntax-theme = none
  minus-style = red
  minus-emph-style = red reverse
  plus-style = green
  plus-emph-style = green reverse

[merge]
  conflictStyle = zdiff3
